---
import type { CategoryIcon } from '../data/catalog';

interface Props {
  name: CategoryIcon;
  size?: number;
}

const { name, size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'cooling' && (
    <path d="M12 2v20M4.5 6.5l15 11M19.5 6.5l-15 11M9.5 3.5 12 6l2.5-2.5M9.5 20.5 12 18l2.5 2.5M3 10l3.3.6-1 3M21 10l-3.3.6 1 3" />
  )}
  {name === 'fan' && (
    <>
      <circle cx="12" cy="12" r="2" />
      <path d="M12 10c0-4 1-7 4-7 2 0 3 2 2 4s-4 3-6 3ZM14 12c4 0 7 1 7 4 0 2-2 3-4 2s-3-4-3-6ZM12 14c0 4-1 7-4 7-2 0-3-2-2-4s4-3 6-3ZM10 12c-4 0-7-1-7-4 0-2 2-3 4-2s3 4 3 6Z" />
    </>
  )}
  {name === 'heat' && (
    <path d="M12 22c4 0 7-3 7-7 0-4-3-6-4-9-.5 2-1.5 3-3 3 .5-3-1-5.5-3-7 0 4-4 6.5-4 12 0 4.5 3 8 7 8ZM12 22c-1.7 0-3-1.3-3-3 0-2 1.5-3 3-5 1.5 2 3 3 3 5 0 1.7-1.3 3-3 3Z" />
  )}
  {name === 'control' && (
    <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0M16 4v4M10 10v4M18 16v4" />
  )}
</svg>
