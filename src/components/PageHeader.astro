---
// Шапка внутренней страницы: хлебные крошки, H1 и вводный абзац.
import { url } from '../lib/url';

interface Crumb {
  title: string;
  href?: string;
}

interface Props {
  title: string;
  lead?: string;
  /** Промежуточные уровни между «Главной» и текущей страницей */
  crumbs?: Crumb[];
}

const { title, lead, crumbs = [] } = Astro.props;
const trail: Crumb[] = [{ title: 'Главная', href: url('/') }, ...crumbs];
---

<section class="page-head">
  <div class="container">
    <nav aria-label="Хлебные крошки">
      <ol class="crumbs">
        {trail.map((c) => (
          <li>{c.href ? <a href={c.href}>{c.title}</a> : <span>{c.title}</span>}</li>
        ))}
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <h1>{title}</h1>
    {lead && <p class="page-head__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head {
    position: relative;
    isolation: isolate;
    padding-block: clamp(32px, 5vw, 64px) clamp(40px, 6vw, 80px);
  }

  /* Та же сетка чертежа, что в hero главной */
  .page-head::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, #000 30%, transparent);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0 0 clamp(24px, 4vw, 40px);
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 10px;
    opacity: 0.6;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(36px, 4.6vw, 64px);
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .page-head__lead {
    max-width: 60ch;
    margin-top: 20px;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--ink-muted);
  }
</style>
