---
import ThermalDemo from './ThermalDemo.astro';
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <h1>Держим электрошкаф в&nbsp;рабочей температуре</h1>
      <p class="hero__lead">
        Кондиционеры, вентиляторы и нагреватели для шкафов автоматики, телекоммуникационных
        и серверных стоек. Подберём оборудование под тепловую нагрузку и условия на объекте.
      </p>
      <div class="hero__actions">
        <a href="#selector" class="btn btn--primary">Подобрать оборудование</a>
        <a href="#catalog" class="btn btn--secondary">Открыть каталог</a>
      </div>
    </div>

    <ThermalDemo />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
  }

  /* Сетка инженерного чертежа, растворяется к низу секции */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding-block: clamp(48px, 7vw, 96px);
  }

  .hero h1 {
    max-width: 12ch;
    font-size: clamp(40px, 5.2vw, 76px);
    overflow-wrap: break-word;
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .hero__lead {
    max-width: 46ch;
    margin-top: 28px;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--ink-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  @media (max-width: 1040px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: 14ch;
    }
  }
</style>
