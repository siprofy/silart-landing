---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { mainNav } from '../data/site';
---

<header class="header">
  <div class="container header__inner">
    <Logo />

    <nav class="header__nav" aria-label="Основная навигация">
      <ul>
        {mainNav.map((link) => (
          <li><a href={link.href}>{link.title}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__tools">
      <ThemeToggle />
      <a href="/#contact" class="btn btn--primary header__cta">Подобрать оборудование</a>

      <details class="header__mobile">
        <summary aria-label="Меню">
          <span></span><span></span>
        </summary>
        <nav aria-label="Мобильная навигация">
          <ul>
            {mainNav.map((link) => (
              <li><a href={link.href}>{link.title}</a></li>
            ))}
          </ul>
          <a href="/#contact" class="btn btn--primary">Подобрать оборудование</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-bg);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 40px;
    min-height: var(--header-h);
  }

  .header__nav ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__nav a {
    font-size: 16px;
    text-decoration: none;
    color: var(--ink-muted);
  }

  .header__nav a:hover {
    color: var(--ink);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .header__cta {
    min-height: 42px;
    padding: 0 18px;
    font-size: 15px;
  }

  .header__mobile {
    display: none;
  }

  .header__mobile summary {
    display: grid;
    place-content: center;
    gap: 6px;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    cursor: pointer;
    list-style: none;
  }

  .header__mobile summary::-webkit-details-marker {
    display: none;
  }

  .header__mobile summary span {
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.2s;
  }

  .header__mobile[open] summary span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .header__mobile[open] summary span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .header__mobile nav {
    position: absolute;
    inset: 100% 0 auto;
    padding: 8px var(--gutter) 24px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .header__mobile ul {
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .header__mobile li a {
    display: block;
    padding: 14px 0;
    font-size: 18px;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .header__mobile .btn {
    width: 100%;
  }

  @media (max-width: 960px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__mobile {
      display: block;
    }
  }
</style>
