---
import Logo from './Logo.astro';
import { mainNav } from '../data/site';
---

<header class="header">
  <div class="container header__inner">
    <Logo />

    <nav class="header__nav" aria-label="Основная навигация">
      <ul>
        {mainNav.map((link) => (
          <li><a href={link.href}>{link.title}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/#contact" class="btn btn--primary header__cta">Подобрать оборудование</a>

    <details class="header__mobile">
      <summary aria-label="Меню">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="Мобильная навигация">
        <ul>
          {mainNav.map((link) => (
            <li><a href={link.href}>{link.title}</a></li>
          ))}
          <li><a href="/#contact" class="btn btn--primary">Подобрать оборудование</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 72px;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul,
  .header__mobile ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__nav a {
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink);
  }

  .header__nav a:hover {
    color: var(--color-accent);
  }

  .header__cta {
    min-height: 42px;
    padding: 0 18px;
  }

  .header__mobile {
    display: none;
    margin-left: auto;
  }

  .header__mobile summary {
    display: grid;
    gap: 5px;
    padding: 10px;
    cursor: pointer;
    list-style: none;
  }

  .header__mobile summary::-webkit-details-marker {
    display: none;
  }

  .header__mobile summary span {
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 1px;
  }

  .header__mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #fff;
    border-bottom: 1px solid var(--color-line);
    box-shadow: var(--shadow);
  }

  .header__mobile ul {
    flex-direction: column;
    gap: 0;
    padding: 8px var(--gutter) 20px;
  }

  .header__mobile li a:not(.btn) {
    display: block;
    padding: 12px 0;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }

  .header__mobile .btn {
    width: 100%;
    margin-top: 16px;
  }

  @media (max-width: 900px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__mobile {
      display: block;
    }
  }
</style>
