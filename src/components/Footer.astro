---
import Logo from './Logo.astro';
import { catalog, categoryUrl } from '../data/catalog';
import { support, company } from '../data/site';
import { contacts } from '../data/company';
import { catalogPdf } from '../data/products';
import { url } from '../lib/url';
import { build } from '../lib/build';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo />
        <p>Климат-контроль для электротехнических шкафов и стоек.</p>
        <p class="footer__contacts">
          <a href={contacts.phoneHref}>{contacts.phone}</a>
          <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
        </p>
      </div>

      <nav aria-label="Продукция">
        <h3>Продукция</h3>
        <ul>
          {catalog.map((c) => <li><a href={categoryUrl(c)}>{c.title}</a></li>)}
          <li><a href={url('/search/')}>Поиск по каталогу</a></li>
          <li><a href={catalogPdf.href} download={catalogPdf.file}>Скачать каталог (PDF)</a></li>
        </ul>
      </nav>

      <nav aria-label="Поддержка">
        <h3>Поддержка</h3>
        <ul>
          {support.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Компания">
        <h3>Компания</h3>
        <ul>
          {company.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} Silart</p>
      <p class="footer__build">
        Обновлено <time datetime={build.dateIso} title={`${build.dateTimeText} (МСК)`}>{build.dateText}</time>{' · '}
        версия {build.version}{' '}
        {build.commitUrl
          ? <a href={build.commitUrl} rel="noopener" title="Изменение в репозитории">({build.shortCommit})</a>
          : <span>({build.shortCommit})</span>}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 56px 32px;
    border-top: 1px solid var(--line);
    background: var(--chrome);
    font-size: 15px;
    color: var(--ink-muted);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 32px;
  }

  .footer__brand p {
    max-width: 28ch;
    margin-top: 14px;
  }

  .footer__contacts {
    display: grid;
    gap: 4px;
    color: var(--ink);
  }

  .footer h3 {
    margin-bottom: 14px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }

  .footer ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--ink);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__build {
    font-variant-numeric: tabular-nums;
  }

  .footer__build a {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
