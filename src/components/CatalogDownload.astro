---
// Блок «Скачать каталог»: обложка, параметры файла и две кнопки — скачать и открыть в браузере.
import { statSync } from 'node:fs';
import { catalogPdf, series } from '../data/products';

// Размер считается при сборке, чтобы не расходился с реальным файлом
const sizeMb = (statSync(catalogPdf.path).size / 1024 / 1024).toLocaleString('ru-RU', {
  maximumFractionDigits: 1,
});
const seriesCount = series.length;
---

<aside class="dl" aria-labelledby="dl-title">
  <a class="dl__cover" href={catalogPdf.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    <img src={catalogPdf.cover} alt="" width="560" height="782" loading="lazy" decoding="async" />
  </a>

  <div class="dl__body">
    <p class="dl__eyebrow">PDF · {catalogPdf.pages} страниц · {sizeMb} МБ</p>
    <h3 id="dl-title">{catalogPdf.title}</h3>
    <p class="dl__text">
      Все {seriesCount} серий с таблицами характеристик, габаритными чертежами и рекомендациями по
      размещению в шкафу. Удобно взять с собой на объект или приложить к проекту.
    </p>
    <div class="dl__actions">
      <a class="btn btn--primary" href={catalogPdf.href} download={catalogPdf.file}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Скачать каталог
      </a>
      <a class="btn btn--secondary" href={catalogPdf.href} target="_blank" rel="noopener">Открыть в браузере</a>
    </div>
  </div>
</aside>

<style>
  .dl {
    display: grid;
    grid-template-columns: 148px minmax(0, 1fr);
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
    margin-top: clamp(32px, 4vw, 48px);
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .dl__cover {
    display: block;
    transform: rotate(-3deg);
    transition: transform 0.25s;
  }

  .dl:hover .dl__cover {
    transform: rotate(0deg) translateY(-4px);
  }

  .dl__cover img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-s);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.12),
      0 12px 28px -8px rgb(0 0 0 / 0.35);
  }

  .dl__eyebrow {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .dl h3 {
    margin-top: 6px;
    font-size: clamp(22px, 2.2vw, 28px);
  }

  .dl__text {
    max-width: 58ch;
    margin-top: 10px;
    color: var(--ink-muted);
  }

  .dl__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .dl__actions .btn {
    gap: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .dl__cover,
    .dl:hover .dl__cover {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .dl {
      grid-template-columns: 1fr;
    }

    .dl__cover {
      width: 120px;
    }

    .dl__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
