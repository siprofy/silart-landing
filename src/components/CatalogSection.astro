---
import { catalog, categoryUrl, groupUrl } from '../data/catalog';
import CatalogDownload from './CatalogDownload.astro';
---

<section id="catalog" class="block">
  <div class="container">
    <h2>Продукция</h2>
    <p class="block__lead">
      Четыре направления закрывают весь микроклимат шкафа: охлаждение, вентиляцию,
      обогрев и управление.
    </p>

    <div class="catalog">
      {catalog.map((category) => (
        <article class:list={['category', `category--${category.tone}`]}>
          <div class="category__head">
            <h3><a href={categoryUrl(category)}>{category.title}</a></h3>
            <p>{category.summary}</p>
          </div>

          <ul class="category__groups">
            {category.groups.map((group) => (
              <li>
                <a href={groupUrl(category, group)}>{group.title}</a>
                <ul class="category__series" aria-label={`Серии: ${group.title}`}>
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <CatalogDownload />
  </div>
</section>

<style>
  .catalog {
    margin-top: clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--line);
  }

  .category {
    --tone: var(--t-neutral);

    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px 48px;
    padding-block: 36px;
    border-top: 1px solid var(--line);
  }

  .category--cold {
    --tone: var(--t-cold);
  }

  .category--air {
    --tone: var(--t-cool);
  }

  .category--hot {
    --tone: var(--t-hot);
  }

  .category__head {
    position: relative;
    padding-left: 22px;
  }

  /* Маркер: место направления на тепловой шкале */
  .category__head::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25em;
    width: 6px;
    height: 1.6em;
    border-radius: 3px;
    background: var(--tone);
  }

  .category h3 {
    font-size: clamp(26px, 2.6vw, 34px);
  }

  .category h3 a {
    text-decoration: none;
  }

  .category h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .category__head p {
    max-width: 40ch;
    margin-top: 12px;
    color: var(--ink-muted);
  }

  .category__groups {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category__groups > li {
    display: grid;
    grid-template-columns: minmax(0, 15em) minmax(0, 1fr);
    gap: 8px 24px;
    align-items: baseline;
    padding-block: 12px;
  }

  .category__groups > li + li {
    border-top: 1px dashed var(--line);
  }

  .category__groups > li > a {
    font-weight: 450;
    text-decoration: none;
  }

  .category__groups > li > a:hover {
    color: var(--accent);
  }

  .category__series {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category__series li {
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--tone) 45%, var(--line));
    border-radius: var(--radius-s);
    font-size: 14px;
    color: var(--ink);
    background: color-mix(in srgb, var(--tone) 8%, transparent);
  }

  @media (max-width: 860px) {
    .category {
      grid-template-columns: 1fr;
    }

    .category__groups > li {
      grid-template-columns: 1fr;
    }
  }
</style>
