---
import { supportGroups } from '../data/site';
---

<section id="support" class="block">
  <div class="container">
    <h2>Поддержка</h2>
    <p class="block__lead">От расчёта тепловой нагрузки до гарантийного обслуживания.</p>

    <div class="support">
      {supportGroups.map((group) => (
        <div class="support__group">
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>
                  <span class="support__title">{link.title}</span>
                  <span class="support__desc">{link.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .support {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .support__group {
    padding: 28px;
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .support__group h3 {
    margin-bottom: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .support ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .support li + li {
    border-top: 1px solid var(--line);
  }

  .support a {
    display: grid;
    gap: 4px;
    padding-block: 16px;
    text-decoration: none;
  }

  .support__title {
    font-size: 20px;
    font-weight: 500;
  }

  .support a:hover .support__title {
    color: var(--accent);
  }

  .support__desc {
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    .support {
      grid-template-columns: 1fr;
    }

    .support__group {
      padding: 20px;
    }
  }
</style>
