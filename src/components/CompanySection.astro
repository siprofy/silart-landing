---
import { company } from '../data/site';
---

<section id="company" class="block">
  <div class="container company">
    <div>
      <h2>Компания</h2>
      <p class="block__lead">
        Разрабатываем и выпускаем оборудование для климат-контроля электротехнических шкафов
        и телекоммуникационных стоек.
      </p>
    </div>

    <ul class="company__links">
      {company.map((link) => (
        <li><a href={link.href}>{link.title}</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .company {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .company__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .company__links a {
    display: block;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 18px;
    text-decoration: none;
  }

  .company__links a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .company {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 480px) {
    .company__links {
      grid-template-columns: 1fr;
    }
  }
</style>
