---
// Форма пока без обработчика: сервис приёма заявок будет выбран отдельным ADR.
---

<section id="contact" class="section contact">
  <div class="container contact__inner">
    <div class="contact__text">
      <span class="eyebrow">Подбор оборудования</span>
      <h2>Не уверены, что выбрать?</h2>
      <p>
        Опишите шкаф и условия эксплуатации — инженеры рассчитают тепловую нагрузку
        и предложат подходящее решение.
      </p>
    </div>

    <form class="contact__form" action="#" method="post">
      <label>
        <span>Имя</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label>
        <span>Телефон или e-mail</span>
        <input type="text" name="contact" autocomplete="email" required />
      </label>
      <label class="contact__wide">
        <span>Задача</span>
        <textarea name="message" rows="4" placeholder="Размеры шкафа, мощность оборудования, место установки, температура окружающей среды"></textarea>
      </label>
      <button type="submit" class="btn btn--primary contact__wide">Отправить запрос</button>
    </form>
  </div>
</section>

<style>
  .contact {
    color: #fff;
    background: var(--color-brand-deep);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }

  .contact .eyebrow {
    color: #7fd3f2;
  }

  .contact h2 {
    font-size: clamp(28px, 3.2vw, 40px);
  }

  .contact__text p {
    margin-top: 16px;
    font-size: 18px;
    color: rgb(255 255 255 / 0.75);
  }

  .contact__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 32px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.12);
  }

  .contact__wide {
    grid-column: 1 / -1;
  }

  .contact__form label {
    display: grid;
    gap: 6px;
    font-size: 14px;
    color: rgb(255 255 255 / 0.8);
  }

  .contact__form input,
  .contact__form textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    font: inherit;
    resize: vertical;
  }

  .contact__form input:focus,
  .contact__form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .contact__form textarea::placeholder {
    color: rgb(255 255 255 / 0.4);
  }

  @media (max-width: 900px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .contact__form {
      grid-template-columns: 1fr;
      padding: 20px;
    }
  }
</style>
