---
import { url } from '../lib/url';
---

<a href={url('/')} class="logo" aria-label="Silart — на главную">
  <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
    <defs>
      <linearGradient id="logo-thermal" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" style="stop-color: var(--t-cold)" />
        <stop offset="0.55" style="stop-color: var(--t-cool)" />
        <stop offset="1" style="stop-color: var(--t-hot)" />
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="26" height="26" rx="6" fill="none" stroke="currentColor" stroke-width="2" />
    <rect x="7" y="6" width="4" height="16" rx="1" fill="url(#logo-thermal)" />
    <rect x="12.5" y="10" width="4" height="12" rx="1" fill="url(#logo-thermal)" />
    <rect x="18" y="14" width="4" height="8" rx="1" fill="url(#logo-thermal)" />
  </svg>
  <span>Silart</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--brand);
  }
</style>
