---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TestimonialsSection from '../../components/TestimonialsSection.astro';
import { careers, contacts } from '../../data/company';
import { employeeReviews, employeeRatings as er, dreamJobUrl } from '../../data/employee-reviews';

const fmt = (n: number) => n.toLocaleString('ru-RU', { minimumFractionDigits: 1 });
import { url } from '../../lib/url';
---

<BaseLayout
  title="Карьера в Silart — вакансии на производстве и в конструкторском бюро"
  description="Работа в Silart: собственное производство и конструкторское бюро в Москве. Открытые вакансии на hh.ru и анкета для кандидатов."
>
  <PageHeader
    title="Карьера у нас"
    lead="Профессионализм, честность, созидание. В Silart инженерные идеи становятся серийными изделиями, а каждый сотрудник видит результат своей работы."
    crumbs={[{ title: 'Компания', href: url('/#company') }]}
  >
    <div class="actions">
      <a class="btn btn--primary" href={careers.links[0].href} target="_blank" rel="noopener">
        Открытые вакансии
      </a>
      <a class="btn btn--secondary" href={careers.links[1].href} target="_blank" rel="noopener">
        Оставить анкету
      </a>
    </div>
  </PageHeader>

  <section class="block block--first">
    <div class="container">
      <h2>Как мы работаем</h2>
      <ul class="cards block__body plain">
        {careers.principles.map((p) => (
          <li class="card">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TestimonialsSection
    id="reviews"
    items={employeeReviews}
    title="Отзывы сотрудников"
    lead={`${er.recommend} % сотрудников рекомендуют Silart как работодателя — по ${er.total} отзывам на DreamJob.`}
    label="Отзывы сотрудников"
  >
    <div class="er">
      <div class="er__score">
        <span class="er__value">{fmt(er.rating)}</span>
        <span class="er__of">из 5</span>
        <span class="er__note">средняя оценка, {er.total} отзывов</span>
      </div>
      <dl class="er__cats">
        {er.categories.map((c) => (
          <div>
            <dt>{c.title}</dt>
            <dd>
              <span class="er__bar" style={`--v: ${c.value}`} aria-hidden="true"></span>
              <span>{fmt(c.value)}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
    <p class="er__disclaimer">
      Кратко пересказываем отзывы своими словами; оценки, должности и даты — как на{' '}
      <a href={dreamJobUrl} target="_blank" rel="noopener">DreamJob</a> ({er.asOf}). Там же — полные
      тексты всех отзывов, включая пожелания к компании.
    </p>
  </TestimonialsSection>

  <section class="block">
    <div class="container split">
      <div>
        <h2>Кого мы ждём</h2>
        <ul class="checklist block__body expect">
          {careers.expectations.map((e) => <li>{e}</li>)}
        </ul>
      </div>

      <ul class="links plain">
        {careers.links.map((l) => (
          <li class="card">
            <h3>{l.title}</h3>
            <p>{l.text}</p>
            <a class="link-arrow" href={l.href} target="_blank" rel="noopener">{l.cta}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <h2>Остались вопросы?</h2>
      <p class="block__lead">
        Звоните <a href={contacts.phoneHref}>{contacts.phone}</a> или пишите на
        <a href={`mailto:${contacts.email}`}>{contacts.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .plain {
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .expect {
    font-size: 19px;
  }

  .links {
    display: grid;
    gap: 16px;
    margin: 0;
  }

  .links p {
    margin-bottom: 14px;
  }

  .block__lead a {
    color: var(--accent);
  }

  /* Сводка оценок DreamJob */
  .er {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: clamp(28px, 4vw, 40px);
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .er__score {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 8px;
  }

  .er__value {
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .er__of {
    color: var(--ink-muted);
  }

  .er__note {
    grid-column: 1 / -1;
    margin-top: 8px;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .er__cats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 32px;
    margin: 0;
  }

  .er__cats div {
    display: grid;
    gap: 4px;
  }

  .er__cats dt {
    font-size: 15px;
    color: var(--ink-muted);
  }

  .er__cats dd {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  .er__bar {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent) calc(var(--v) / 5 * 100%), var(--surface-2) 0);
  }

  .er__disclaimer {
    max-width: 80ch;
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .er__disclaimer a {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .er {
      grid-template-columns: 1fr;
    }

    .er__cats {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
